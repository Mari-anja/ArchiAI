# --- auth -------------------------------------------------------------
# Comma-separated. Arqio's backend sends one as: Authorization: Bearer <key>
# If unset the service accepts anonymous calls, which is only safe locally.
ARCHIAI_API_KEYS=replace-me-with-a-long-random-string

# --- storage ----------------------------------------------------------
ARCHIAI_STORAGE=supabase
SUPABASE_URL=https://pxhmmuaszwiwcxdkeynl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # service role, server-side only, never shipped to a browser
SUPABASE_BUCKET=building-projects
SUPABASE_BUCKET_PUBLIC=true         # false if you'd rather sign every URL

# --- limits -----------------------------------------------------------
ARCHIAI_MAX_STOREYS=60
ARCHIAI_MAX_AREA_M2=400000
ARCHIAI_UPLOAD_TIMEOUT=30

# --- local development instead of Supabase ----------------------------
# ARCHIAI_STORAGE=local
# ARCHIAI_LOCAL_ROOT=/tmp/archiai-output
# ARCHIAI_PUBLIC_BASE=http://localhost:8080
